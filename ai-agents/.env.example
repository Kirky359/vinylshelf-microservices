# REST API of lab 3 (api-gateway)
GATEWAY_URL=http://localhost:8080

# the agents act on behalf of this user; it is registered/logged in automatically on start
AGENT_USERNAME=artem@pm.me
AGENT_PASSWORD=change-me

# LLM (Task 1 and text requests of Task 3). Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Task 1 guardrails
MAX_SESSION_TOKENS=20000
MAX_SESSION_REQUESTS=30
MAX_REQUEST_TOKENS=8000
MAX_TOOL_ROUNDS=8

# Task 2 (MCP)
MCP_TRANSPORT=stdio
MCP_READ_ONLY=false
